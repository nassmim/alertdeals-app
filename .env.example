# Copy this file to `.env.local` and fill in personal cross-environment secrets.
# Then copy `.env.[NODE_ENV].example` → `.env.development.local` for dev DB / Stripe / etc.
# Ask a teammate for the values.

# Personal cross-env secrets (used in any NODE_ENV)
RESEND_API_KEY=
WORKER_API_SECRET=

# WhatsApp — clé 32 octets en hex (64 caractères) pour encrypter la session
# Baileys stockée dans la table `whatsapp_sessions`. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_ENCRYPTION_KEY=

# Stripe — test keys (sk_test_… / whsec_…) for local dev, live keys in prod
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# mytracks
MYTRACKS_API_KEY=

# CORS — origins du site vitrine autorisés à fetch /api/plans (séparés par virgule)
# dev : http://localhost:4321   |   prod : https://alertdeals.fr,https://www.alertdeals.fr
CORS_ALLOWED_ORIGINS=